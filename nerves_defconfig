BR2_PACKAGE_RPI_LIBCAMERA_V4L2=y

# --- Kiosk additions ---
# Mesa3D + VC4 driver (Pi 3 GPU). Pi 4/5 use V3D; do not enable both.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# Wayland (Cog uses some wayland headers/libs even on the DRM platform).
BR2_PACKAGE_WAYLAND=y
# BR2_PACKAGE_WESTON intentionally not set — Cog's DRM platform plugin
# renders directly to /dev/dri/card0 via libwpe + libdrm + Mesa/GBM, no
# Wayland compositor needed. Weston also has a build-time cairo-PNG
# dependency that wasn't satisfied in our minimal stack.

# WPE WebKit + Cog: lightweight kiosk browser (single-page fullscreen).
# Multimedia (HTML5 video, GStreamer integration in WebKit) is intentionally
# omitted — that's the largest subsystem of WebKit and adds ~60 min to the
# build. For our use case (Phoenix LiveView dashboard) the browser doesn't
# need to play media; alarm audio is played from the BEAM directly via ALSA
# on the USB speaker.
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_COG=y

# Touch + input handling for the DSI touchscreen.
# eudev is required by libinput's device enumeration and gates Cog's
# DRM platform plugin (via BR2_PACKAGE_HAS_UDEV). Enabling
# BR2_PACKAGE_EUDEV requires switching the rootfs device-creation method
# from the stock devtmpfs to eudev so eudev owns /dev.
# BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS is not set
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_LIBINPUT=y

# Cog DRM platform plugin: renders directly to /dev/dri/card0 via libwpe
# + Mesa/GBM. No Wayland compositor needed — perfect for a single-page
# kiosk on a DSI touchscreen.
BR2_PACKAGE_COG_PLATFORM_DRM=y

# TLS over libsoup3 (used by WPE for HTTPS)
BR2_PACKAGE_LIBSOUP3_SSL=y

# GStreamer GL plugin omitted — only needed when WPE multimedia is enabled.
# (See WPEWEBKIT_MULTIMEDIA note above.)

# Default UI font for the browser
BR2_PACKAGE_LIBERATION=y
